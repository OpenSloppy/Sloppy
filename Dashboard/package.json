{
  "name": "sloppy-dashboard",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "build:dev": "node ./node_modules/vite/bin/vite.js build --mode development",
    "typecheck": "tsc --noEmit",
    "test:config-auth": "node --test ./scripts/configAuthTest.mjs",
    "test:performance": "node --test ./scripts/requestPerformanceTest.mjs",
    "test:auth": "node --test ./scripts/configAuthTest.mjs ./scripts/authInvalidationTest.mjs",
    "test:session-mentions": "node --test ./scripts/sessionMentionsTest.mjs",
    "test:semantic-decisions": "node --test ./scripts/semanticDecisionsTest.mjs",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "seed:happy-path": "node ./scripts/seedHappyPath.mjs",
    "e2e:happy-path": "node ./scripts/happyPath.mjs"
  },
  "dependencies": {
    "@git-diff-view/file": "^0.1.2",
    "@git-diff-view/react": "^0.1.2",
    "@lobehub/icons": "^5.4.0",
    "@types/prismjs": "^1.26.6",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.11.2",
    "prismjs": "^1.30.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "recharts": "^2.15.4",
    "remark-gfm": "^4.0.1",
    "vis-data": "^8.0.3",
    "vis-network": "^10.0.2"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^0.1.97",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "playwright": "^1.55.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
